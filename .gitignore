.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
.DS_Store
calibration/output/chains/
# Raw downloads are reproducible from data-raw/download_data.R; the MANIFEST
# (URL + access date + SHA-256 + citation) IS tracked as the provenance record.
# NB: must exclude the directory's *contents*, not the directory itself --
# git cannot re-include a file whose parent directory is excluded.
data-raw/downloads/*
!data-raw/downloads/MANIFEST.csv
# ...and the two SMALL extracts from the bulk seasonality inputs (review item
# 5c). They are ~30 KB together and they are what lets a fresh clone run
# data-raw/build_emission_seasonality.R WITHOUT re-downloading 1.2 GB of GFED
# hdf5 and a 26 MB EDGAR xlsx. The bulk inputs stay ignored; the extraction step
# that produces these is data-raw/extract_emission_seasonality.py.
!data-raw/downloads/seasonality_fire.csv
!data-raw/downloads/seasonality_fossil.csv
src/*.o
src/*.so

# testthat scratch (the "check" reporter writes these; never repo state)
tests/testthat/_problems/
tests/testthat/testthat-problems.rds

# Word lock files -- transient, never content (2026-09-24)
~$*

# Marcus's own drafting, kept in the repo root but NOT repo content
# (2026-09-24, his instruction). `git add -A` was staging it; this stops that.
# ⚠ The docx REVIEW files he sends IN are tracked on purpose
# (CarboTopecomments.*.docx) -- this excludes only the draft he is writing.
CarboTopeSubstack.docx
